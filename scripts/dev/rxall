#!/bin/zsh
# rxall <issue> [<issue> ...] — run several rx tasks in parallel (max 3 at once) and print every PR link at the end.
set -u
model=""
if [ "${1:-}" = "-m" ]; then model=${2:-}; shift 2 2>/dev/null || shift $#; fi
[ $# -eq 0 ] && { echo "usage: rxall [-m model] 114 117 118 119"; exit 1; }
export SSL_CERT_FILE=$(python3 -c "import certifi;print(certifi.where())" 2>/dev/null)
logdir=$(mktemp -d /tmp/rxall.XXXXXX)
running=0
for n in "$@"; do
  ( /Users/mac/bin/rx "$n" ${model:+"$model"} > "$logdir/$n.log" 2>&1; echo "== #$n finished (exit $?)" ) &
  running=$((running+1))
  sleep 8   # stagger: git worktree add locks .git/config, parallel starts collide
  if [ $running -ge 3 ]; then wait -n 2>/dev/null || wait; running=$((running-1)); fi
done
wait
echo; echo "========== RESULTS =========="
for n in "$@"; do
  echo "#$n: $(grep -Eo 'https://github.com/[^ ]+/pull/[0-9]+' "$logdir/$n.log" | tail -1 || true)"
  grep -q "rx: no changes" "$logdir/$n.log" && echo "   (no changes: task probably already done)"
  grep -qiE "insufficient|402|credit" "$logdir/$n.log" && echo "   WARNING: OpenRouter credit/limit error, see $logdir/$n.log"
done
echo "logs: $logdir"
